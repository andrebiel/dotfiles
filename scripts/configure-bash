#!/usr/bin/env python3
"""Prepend an idempotent environment hook without replacing local Bash settings."""
import os
from pathlib import Path
import tempfile

hook = '''# >>> dotfiles shared environment >>>
if [ -n "${BASH_VERSION:-}${ZSH_VERSION:-}" ] && [ -r "$HOME/.config/zsh/environment.sh" ]; then
  . "$HOME/.config/zsh/environment.sh"
fi
# <<< dotfiles shared environment <<<

'''
user_home = Path.home()
login_file = next(
    (user_home / name for name in (".bash_profile", ".bash_login", ".profile")
     if (user_home / name).exists()),
    user_home / ".bash_profile",
)
for entry in (user_home / ".bashrc", login_file):
    # Preserve an existing symlink and edit its target atomically.
    target = entry.resolve()
    original = target.read_bytes() if target.exists() else b""
    if original.startswith(hook.encode()):
        continue
    if b"# >>> dotfiles shared environment >>>" in original:
        raise SystemExit(f"Existing modified environment hook in {entry}; refusing to duplicate it")
    target.parent.mkdir(parents=True, exist_ok=True)
    mode = target.stat().st_mode & 0o777 if target.exists() else 0o600
    fd, temporary = tempfile.mkstemp(prefix=".dotfiles-bash-", dir=target.parent)
    try:
        with os.fdopen(fd, "wb") as output:
            output.write(hook.encode() + original)
        os.chmod(temporary, mode)
        os.replace(temporary, target)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    print(f"Configured shared environment in {entry}")
