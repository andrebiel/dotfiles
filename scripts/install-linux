#!/usr/bin/env bash
set -euo pipefail
# Ubuntu/Debian CLI profile. Editor and language-tool releases are pinned below.
[[ "$(uname -s)" == Linux ]] || { echo 'Linux installer requires Linux' >&2; exit 1; }
command -v apt-get >/dev/null || { echo 'Automatic Linux installation currently supports Ubuntu/Debian (apt).' >&2; exit 1; }
case "$(uname -m)" in
  x86_64) arch=amd64; nvim_arch=x86_64 ;;
  aarch64|arm64) arch=arm64; nvim_arch=arm64 ;;
  *) echo 'Supported Linux architectures: x86_64 and arm64' >&2; exit 1 ;;
esac
privilege=()
if (( EUID != 0 )); then privilege=(sudo); fi
"${privilege[@]}" apt-get update -qq
"${privilege[@]}" env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
  ca-certificates curl git gnupg unzip xz-utils build-essential python3 python3-venv \
  zsh zsh-autosuggestions zsh-syntax-highlighting stow jq ripgrep fzf gh openssh-client xdg-utils
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
mkdir -p "$HOME/.local/bin" "$HOME/.local/opt"
export PATH="$HOME/.local/bin:$HOME/.bun/bin:$PATH"
# The official installer verifies the release checksum and updates the binary
# without stopping existing Herdr sessions.
curl -fsSL --retry 3 https://herdr.dev/install.sh -o "$work/herdr-install.sh"
HERDR_INSTALL_DIR="$HOME/.local/bin" sh "$work/herdr-install.sh"
if ! command -v lazygit >/dev/null; then
  bash "$(dirname "${BASH_SOURCE[0]}")/install-lazygit"
fi
# Official signed 1Password APT repository, including its package signature policy.
if ! command -v op >/dev/null; then
  curl -fsSL https://downloads.1password.com/linux/keys/1password.asc -o "$work/1password.asc"
  gpg --batch --yes --dearmor -o "$work/1password.gpg" "$work/1password.asc"
  "${privilege[@]}" install -m 644 "$work/1password.gpg" /usr/share/keyrings/1password-archive-keyring.gpg
  printf 'deb [arch=%s signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/%s stable main\n' "$arch" "$arch" >"$work/1password.list"
  "${privilege[@]}" install -m 644 "$work/1password.list" /etc/apt/sources.list.d/1password.list
  curl -fsSL https://downloads.1password.com/linux/debian/debsig/1password.pol -o "$work/1password.pol"
  "${privilege[@]}" install -D -m 644 "$work/1password.pol" /etc/debsig/policies/AC2D62742012EA22/1password.pol
  "${privilege[@]}" install -D -m 644 "$work/1password.gpg" /usr/share/debsig/keyrings/AC2D62742012EA22/debsig.gpg
  "${privilege[@]}" apt-get update -qq
  "${privilege[@]}" env DEBIAN_FRONTEND=noninteractive apt-get install -y 1password-cli
fi
if [[ ! -x "$HOME/.local/opt/nvim-v0.12.5/bin/nvim" ]]; then
  curl -fL --retry 3 "https://github.com/neovim/neovim/releases/download/v0.12.5/nvim-linux-$nvim_arch.tar.gz" -o "$work/nvim.tar.gz"
  tar -xzf "$work/nvim.tar.gz" -C "$work"
  mv "$work/nvim-linux-$nvim_arch" "$HOME/.local/opt/nvim-v0.12.5"
fi
ln -sfn "$HOME/.local/opt/nvim-v0.12.5/bin/nvim" "$HOME/.local/bin/nvim"
if ! command -v oh-my-posh >/dev/null; then
  curl -fsSL https://ohmyposh.dev/install.sh -o "$work/posh-install.sh"
  bash "$work/posh-install.sh" -d "$HOME/.local/bin"
fi
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [[ ! -s "$NVM_DIR/nvm.sh" ]]; then
  curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.7/install.sh -o "$work/nvm-install.sh"
  PROFILE=/dev/null bash "$work/nvm-install.sh"
fi
# nvm references optional variables that are incompatible with nounset.
set +u
source "$NVM_DIR/nvm.sh"
nvm install --lts
nvm alias default 'lts/*'
set -u
npm install --global "pnpm@${PNPM_VERSION:-12.4.1}"
if ! command -v bun >/dev/null; then
  curl -fsSL https://bun.sh/install -o "$work/bun-install.sh"
  BUN_INSTALL="$HOME/.bun" bash "$work/bun-install.sh"
fi
bash "$(dirname "${BASH_SOURCE[0]}")/install-tree-sitter"
if ! command -v claude >/dev/null; then
  curl -fsSL --retry 3 https://claude.ai/install.sh -o "$work/claude-install.sh"
  bash "$work/claude-install.sh" latest
fi
if ! command -v granted >/dev/null; then
  curl -fL --retry 3 "https://github.com/fwdcloudsec/granted/releases/download/v0.39.0/granted_0.39.0_linux_$arch.deb" -o "$work/granted.deb"
  chmod 755 "$work"
  "${privilege[@]}" env DEBIAN_FRONTEND=noninteractive apt-get install -y "$work/granted.deb"
fi
printf 'Linux CLI dependencies installed, including Herdr. Ghostty, CodexBar and launchd are excluded from this server profile.\n'
