#!/usr/bin/env bash
set +x
set -euo pipefail

SOURCE_ZSHRC="${1:-$HOME/.zshrc}"
VAULT_NAME="Private"
ITEM_NAME="Dotfiles"
DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SECRETS_TEMPLATE="$DOTFILES_DIR/secrets/secrets.zsh.tpl"

fail() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

command -v op >/dev/null 2>&1 || fail "1Password CLI (op) is not installed"
command -v jq >/dev/null 2>&1 || fail "jq is not installed"
[[ -r "$SOURCE_ZSHRC" ]] || fail "cannot read $SOURCE_ZSHRC"
[[ -r "$SECRETS_TEMPLATE" ]] || fail "cannot read $SECRETS_TEMPLATE"

SECRET_NAMES=()
while IFS= read -r secret_name; do
  SECRET_NAMES+=("$secret_name")
done < <(sed -n 's#.*op://Private/Dotfiles/\([A-Z0-9_]*\).*#\1#p' "$SECRETS_TEMPLATE")
[[ "${#SECRET_NAMES[@]}" -gt 0 ]] || fail "no secret fields found in $SECRETS_TEMPLATE"

declare -a SECRET_VALUES=()
for secret_name in "${SECRET_NAMES[@]}"; do
  match_count="$(grep -Ec "^[[:space:]]*export[[:space:]]+${secret_name}=" "$SOURCE_ZSHRC" || true)"
  [[ "$match_count" -eq 1 ]] ||
    fail "$secret_name must have exactly one single-line literal export in $SOURCE_ZSHRC"
  assignment="$(grep -E "^[[:space:]]*export[[:space:]]+${secret_name}=" "$SOURCE_ZSHRC")"
  prefix="export ${secret_name}="
  [[ "$assignment" == "$prefix"* ]] ||
    fail "$secret_name uses unsupported assignment spacing or syntax"
  secret_literal="${assignment#"$prefix"}"

  if [[ ${#secret_literal} -ge 2 &&
        "${secret_literal:0:1}" == "'" &&
        "${secret_literal: -1}" == "'" ]]; then
    secret_value="${secret_literal:1:${#secret_literal}-2}"
    [[ "$secret_value" != *"'"* ]] ||
      fail "$secret_name contains an unsupported quote in a single-quoted literal"
  elif [[ ${#secret_literal} -ge 2 &&
          "${secret_literal:0:1}" == '"' &&
          "${secret_literal: -1}" == '"' ]]; then
    encoded="${secret_literal:1:${#secret_literal}-2}"
    [[ "$encoded" != *'$'* && "$encoded" != *'`'* ]] ||
      fail "$secret_name contains an expansion or command substitution"
    secret_value=""
    position=0
    while (( position < ${#encoded} )); do
      character="${encoded:position:1}"
      if [[ "$character" == \\ ]]; then
        (( position + 1 < ${#encoded} )) ||
          fail "$secret_name ends with an unsupported escape"
        escaped="${encoded:position+1:1}"
        [[ "$escaped" == \\ || "$escaped" == '"' ]] ||
          fail "$secret_name contains an unsupported escape"
        secret_value+="$escaped"
        (( position += 2 ))
      else
        [[ "$character" != '"' ]] ||
          fail "$secret_name contains an unescaped quote in a double-quoted literal"
        secret_value+="$character"
        (( position += 1 ))
      fi
    done
  elif [[ "$secret_literal" =~ ^[A-Za-z0-9_./:@%+=,-]+$ ]]; then
    secret_value="$secret_literal"
  else
    fail "$secret_name must use a supported single-line literal assignment"
  fi

  [[ -n "$secret_value" ]] || fail "$secret_name has an empty value"
  SECRET_VALUES+=("$secret_value")
done

if op item get "$ITEM_NAME" --vault "$VAULT_NAME" >/dev/null 2>&1; then
  item_id="$(op item get "$ITEM_NAME" --vault "$VAULT_NAME" --format json | jq -er '.id')"
  for index in "${!SECRET_NAMES[@]}"; do
    stored_value="$(
      op item get "$item_id" --vault "$VAULT_NAME" --format json |
        jq -er --arg label "${SECRET_NAMES[$index]}" \
          '.fields[] | select(.label == $label) | .value'
    )"
    [[ "$stored_value" == "${SECRET_VALUES[$index]}" ]] ||
      fail "$VAULT_NAME/$ITEM_NAME exists but ${SECRET_NAMES[$index]} does not match the source file"
  done
  unset SECRET_VALUES secret_value stored_value assignment
  printf 'Reusing verified %s/%s item %s.\n' "$VAULT_NAME" "$ITEM_NAME" "$item_id"
  exit 0
fi

vault_id="$(op vault get "$VAULT_NAME" --format json | jq -er '.id')"

item_id="$({
  for index in "${!SECRET_NAMES[@]}"; do
    printf '%s\0%s\0' "${SECRET_NAMES[$index]}" "${SECRET_VALUES[$index]}"
  done
} | jq -Rs --arg vault_id "$vault_id" '
  (split("\u0000") | .[0:-1]) as $parts
  | {
      title: "Dotfiles",
      category: "SECURE_NOTE",
      vault: {id: $vault_id},
      fields: (
        [
          range(0; ($parts | length); 2)
          | {
              type: "CONCEALED",
              label: $parts[.],
              value: $parts[. + 1]
            }
        ]
      )
    }
' | op item create - --format json | jq -er '.id')"

for secret_name in "${SECRET_NAMES[@]}"; do
  op item get "$item_id" --vault "$VAULT_NAME" --format json |
    jq -e --arg label "$secret_name" \
      'any(.fields[]; .label == $label and (.value | type == "string") and (.value | length > 0))' \
      >/dev/null || fail "verification failed for $secret_name"
done

unset SECRET_VALUES secret_value assignment
printf 'Imported %d secrets into %s/%s (item %s).\n' "${#SECRET_NAMES[@]}" "$VAULT_NAME" "$ITEM_NAME" "$item_id"
printf 'The commented legacy Storyblok token was not imported. Revoke it separately.\n'
