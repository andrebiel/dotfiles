#!/usr/bin/env bun

import { buildSnapshot, refreshAll } from "../lib/ai-usage/snapshot.js";
import { show } from "../lib/ai-usage/dashboard.js";

function printHelp() {
  process.stdout.write("Usage: ai-usage [show|refresh|snapshot --json]\n");
}

async function main() {
  const [command = "show", ...flags] = process.argv.slice(2);
  if (command === "snapshot" && flags.includes("--json")) {
    process.stdout.write(`${JSON.stringify(await buildSnapshot())}\n`);
    return;
  }
  if (command === "refresh") {
    const snapshot = await refreshAll({ fetchLimits: !flags.includes("--local-only") });
    if (flags.includes("--json")) process.stdout.write(`${JSON.stringify(snapshot)}\n`);
    return;
  }
  if (command === "show") {
    await show({ once: flags.includes("--once") });
    return;
  }
  if (command === "--help" || command === "help") {
    printHelp();
    return;
  }
  printHelp();
  process.exitCode = 2;
}

await main();
