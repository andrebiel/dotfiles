#!/usr/bin/env bash
set -euo pipefail

fail() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

rg_bin="${HERDR_RG_BIN:-rg}"
fzf_bin="${HERDR_FZF_BIN:-fzf}"
editor_bin="${HERDR_EDITOR_BIN:-nvim}"
herdr_bin="${HERDR_BIN_PATH:-herdr}"
# Custom-command popups receive ACTIVE_* context; normal panes receive the
# unprefixed IDs. Prefer the popup's caller over any stale server inheritance.
workspace_id="${HERDR_ACTIVE_WORKSPACE_ID:-${HERDR_WORKSPACE_ID:-}}"
copy_bin="${HERDR_COPY_BIN:-}"
if [[ "$(uname -s)" == Darwin ]]; then
  open_bin="${HERDR_OPEN_BIN:-open}"
else
  open_bin="${HERDR_OPEN_BIN:-xdg-open}"
  # SSH-started Herdr servers lack the desktop session; borrow the local one.
  runtime_dir="/run/user/$(id -u)"
  if [[ -z "${WAYLAND_DISPLAY:-}${DISPLAY:-}" && -S "$runtime_dir/wayland-0" ]]; then
    export XDG_RUNTIME_DIR="$runtime_dir" WAYLAND_DISPLAY=wayland-0
    [[ -S "$runtime_dir/bus" ]] && export DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime_dir/bus"
  fi
fi
search_root="${HERDR_ACTIVE_PANE_CWD:-$PWD}"

# Put the files themselves on the clipboard so Finder, Mail or chat apps can
# paste them; text-only clipboards would just receive the paths.
copy_files() {
  if [[ -n "$copy_bin" ]]; then
    "$copy_bin" "$@"
  elif [[ "$(uname -s)" == Darwin ]]; then
    osascript -l JavaScript -e '
      ObjC.import("AppKit");
      function run(argv) {
        const urls = $.NSMutableArray.array;
        argv.forEach(path => urls.addObject($.NSURL.fileURLWithPath(path)));
        const pasteboard = $.NSPasteboard.generalPasteboard;
        pasteboard.clearContents;
        if (!pasteboard.writeObjects(urls)) throw new Error("clipboard write failed");
        // The pasteboard server receives the items asynchronously; exiting at
        // once drops some or all of them.
        delay(0.2);
      }' "$@" >/dev/null
  else
    local uri_list='' path encoded hex
    for path in "$@"; do
      # Percent-encode byte by byte so UTF-8 and newlines survive the URI.
      encoded=''
      for hex in $(printf '%s' "$path" | od -An -v -tx1); do
        case "$hex" in
          2[def]|3[0-9]|4[1-9a-f]|5[0-9a]|5f|6[1-9a-f]|7[0-9a]|7e) printf -v hex "\\x$hex"; encoded+="$hex" ;;
          *) printf -v hex '%%%02X' "0x$hex"; encoded+="$hex" ;;
        esac
      done
      uri_list+="file://$encoded"$'\r\n'
    done
    if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v wl-copy >/dev/null 2>&1; then
      printf '%s' "$uri_list" | wl-copy --type text/uri-list
    elif [[ -n "${DISPLAY:-}" ]] && command -v xclip >/dev/null 2>&1; then
      printf '%s' "$uri_list" | xclip -selection clipboard -t text/uri-list
    else
      fail 'copying files needs a desktop session with wl-copy or xclip'
    fi
  fi
}

command -v "$rg_bin" >/dev/null 2>&1 || fail "ripgrep is required"
command -v "$fzf_bin" >/dev/null 2>&1 || fail "fzf is required"
[[ -d "$search_root" ]] || fail "directory does not exist: $search_root"
search_root="$(cd "$search_root" && pwd -P)"

umask 077
selection_file="$(mktemp "${TMPDIR:-/tmp}/herdr-fuzzy-open.XXXXXX")"
cleanup() {
  rm -f -- "$selection_file"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

set +e
(
  cd "$search_root"
  # This is a file browser: include ignored files such as .env as well.
  "$rg_bin" --files --hidden --no-ignore --glob '!.git' --null |
    "$fzf_bin" \
      --read0 \
      --print0 \
      --multi \
      --expect=ctrl-o,ctrl-y \
      --disabled \
      --layout=reverse \
      --border=rounded \
      --info=inline \
      --prompt='Normal> ' \
      --header='j/k navigate · / search · Ctrl-G normal · Tab select · Enter open · Ctrl-O editor tab · Ctrl-Y copy · Esc close' \
      --bind=j:down,k:up \
      --bind='/:enable-search+unbind(j,k,/)+change-prompt(Search> )' \
      --bind='ctrl-g:disable-search+rebind(j,k,/)+change-prompt(Normal> )' >"$selection_file"
)
picker_status=$?
set -e

case "$picker_status" in
  0) ;;
  1|130) exit 0 ;;
  *) fail "file picker failed with status $picker_status" ;;
esac

selected_files=()
{
  # With --expect and --print0, fzf prefixes selections with a NUL-delimited
  # key name (empty for Enter). Keep filenames NUL-delimited as well.
  IFS= read -r -d '' action || fail 'file picker did not return an action'
  while IFS= read -r -d '' relative_path; do
    selected_path="$search_root/$relative_path"
    [[ -f "$selected_path" ]] || fail "file no longer exists: $selected_path"
    selected_files+=("$selected_path")
  done
} <"$selection_file"
((${#selected_files[@]} > 0)) || exit 0

case "$action" in
  '')
    command -v "$open_bin" >/dev/null 2>&1 || fail "$open_bin is required"
    for selected_path in "${selected_files[@]}"; do
      # Absolute paths are safe; xdg-open does not accept an option terminator.
      "$open_bin" "$selected_path"
    done
    ;;
  ctrl-o)
    command -v "$editor_bin" >/dev/null 2>&1 || fail "$editor_bin is required"
    command -v "$herdr_bin" >/dev/null 2>&1 || fail 'Herdr is required for an editor tab'
    command -v jq >/dev/null 2>&1 || fail 'jq is required for an editor tab'
    [[ "${HERDR_ENV:-}" == 1 && -n "$workspace_id" ]] ||
      fail 'Open the editor tab from a Herdr workspace'
    # Quote each argument for the configured Zsh shell; paths are never code.
    printf -v editor_command '%q ' "$(command -v "$editor_bin")" -- "${selected_files[@]}"
    created="$("$herdr_bin" tab create --workspace "$workspace_id" --cwd "$search_root" --label Neovim --no-focus)"
    pane_id="$(jq -er '.result.root_pane.pane_id' <<<"$created")"
    tab_id="$(jq -er '.result.tab.tab_id' <<<"$created")"
    "$herdr_bin" pane run "$pane_id" "$editor_command"
    "$herdr_bin" tab focus "$tab_id" >/dev/null
    ;;
  ctrl-y)
    copy_files "${selected_files[@]}"
    ;;
  *) fail "unexpected picker action: $action" ;;
esac
